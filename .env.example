# =============================================================================
# VITRIVO — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores locais.
# NUNCA coloque credenciais reais neste arquivo (.env.example) nem no
# repositório. Segredos reais só existem em ambientes protegidos (.env local
# ignorado pelo git, ou nas variáveis de ambiente do provedor de deploy).
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Desenvolvimento/teste: SQLite local (arquivo, sem servidor).
# Produção: troque para PostgreSQL (ex.: Vercel Postgres, Neon, Supabase) e
# ajuste "provider" em prisma/schema.prisma para "postgresql".
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Autenticação (NextAuth.js)
# -----------------------------------------------------------------------------
# Gere um valor com: npx auth secret   (ou: openssl rand -base64 32)
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"
# URL pública da aplicação (necessária em produção).
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Identidade da marca (públicas — usadas também no navegador)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="VITRIVO"
NEXT_PUBLIC_SITE_SLOGAN="Curadoria confiável de produtos"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contato@exemplo.com"
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TIKTOK=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""

# -----------------------------------------------------------------------------
# Analytics e pixels (opcionais — o site funciona normalmente vazio)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# -----------------------------------------------------------------------------
# Recursos habilitáveis (feature flags)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FEATURE_GUIDES="true"
NEXT_PUBLIC_FEATURE_NEWSLETTER="false"

# -----------------------------------------------------------------------------
# Segurança de redirecionamento afiliado
# -----------------------------------------------------------------------------
# Lista adicional de hosts globalmente permitidos, separados por vírgula.
# A allowlist principal fica no banco (tabela Marketplace.allowedHosts),
# gerenciável pelo admin. Esta variável serve como reforço/override de
# infraestrutura, opcional.
REDIRECT_EXTRA_ALLOWED_HOSTS=""

# -----------------------------------------------------------------------------
# Upload de imagens (Vercel Blob)
# -----------------------------------------------------------------------------
# Gerado automaticamente ao conectar um Blob Store ao projeto na Vercel
# (Storage → Create Database → Blob). Em desenvolvimento local, rode
# `npx vercel env pull` ou copie o valor do painel da Vercel.
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Testes automatizados (arquivo separado, NUNCA aponte para produção)
# -----------------------------------------------------------------------------
# Crie um arquivo ".env.test.local" (ignorado pelo git) com um Postgres de
# teste dedicado — por exemplo, um segundo banco no mesmo projeto Neon
# (`CREATE DATABASE vitrivo_test;`), nunca o banco de produção:
#
#   TEST_DATABASE_URL="postgresql://.../vitrivo_test?sslmode=require"
#   TEST_DIRECT_URL="postgresql://.../vitrivo_test?sslmode=require"
#
# `npm test` reseta o schema desse banco a cada execução (prisma db push
# --accept-data-loss) — nunca aponte para um banco com dados reais.
